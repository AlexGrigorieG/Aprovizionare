@host = http://localhost:5269

### Fără login
GET {{host}}/api/auth/me

### Login cu parolă greșită
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "maria@firma.ro", "password": "gresit" }

### Login corect
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "maria@firma.ro", "password": "Parola123!" }

### Acum trebuie să dea emailul Mariei și rolul Warehouse
GET {{host}}/api/auth/me

### Logout
POST {{host}}/api/auth/logout


######## COMENZI ########

### 1. Login ca Andrei (Achiziții)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "andrei@firma.ro", "password": "Parola123!" }

### 2. creează o comandă
POST {{host}}/api/purchase-orders
Content-Type: application/json

{
  "supplierId": 2,
  "expectedDeliveryDate": "2026-11-15",
  "currency": "EUR",
  "lines": [
    { "productId": 1, "quantity": 100, "unitPrice": 120 },
    { "productId": 2, "quantity": 50, "unitPrice": 8 }
  ]
}

### 3. Comandă fără linii
POST {{host}}/api/purchase-orders
Content-Type: application/json

{ "supplierId": 2, "expectedDeliveryDate": "2026-11-15", "currency": "EUR", "lines": [] }

### 4. Andrei vede lista, cu prețuri
GET {{host}}/api/purchase-orders

### 5. Login ca Maria (Depozit)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "maria@firma.ro", "password": "Parola123!" }

### 6. Maria vede lista, cu unitPrice null
GET {{host}}/api/purchase-orders

### 7. Maria încearcă să creeze o comandă
POST {{host}}/api/purchase-orders
Content-Type: application/json

{
  "supplierId": 1,
  "expectedDeliveryDate": "2026-11-15",
  "currency": "RON",
  "lines": [ { "productId": 1, "quantity": 1, "unitPrice": 1 } ]
}


######## RECEPȚII ########
# Folosește comanda creată la pasul 2 din secțiunea COMENZI.
# Dacă are alt id decât 1, schimbă purchaseOrderId mai jos.

### 8. Maria: prima tranșă, cu 60 de motocoase, 70 de lanțuri (20 peste comandă) și 10 perechi de mănuși necomandate
POST {{host}}/api/goods-receipts
Content-Type: application/json

{
  "supplierId": 2,
  "purchaseOrderId": 1,
  "receivedDate": "2026-10-20",
  "notes": "Tranșa 1",
  "lines": [
    { "productId": 1, "quantity": 60 },
    { "productId": 2, "quantity": 70 },
    { "productId": 3, "quantity": 10 }
  ]
}

### 9. Comanda trebuie să fie PartiallyReceived, cu 60/100 motocoase și 50/50 lanțuri
GET {{host}}/api/purchase-orders/1

### 10. Maria: a doua tranșă, cu restul de 40 de motocoase
POST {{host}}/api/goods-receipts
Content-Type: application/json

{
  "supplierId": 2,
  "purchaseOrderId": 1,
  "receivedDate": "2026-10-20",
  "notes": "Tranșa 2",
  "lines": [ { "productId": 1, "quantity": 40 } ]
}

### 11. Comanda trebuie să fie Received
GET {{host}}/api/purchase-orders/1

### 12. Recepție cu dată în viitor
POST {{host}}/api/goods-receipts
Content-Type: application/json

{ "supplierId": 2, "receivedDate": "2030-01-01", "lines": [ { "productId": 1, "quantity": 1 } ] }

### 13. Stocul: 100 de motocoase, 70 de lanțuri, 10 perechi de mănuși
GET {{host}}/api/stock

### 14. Lista recepțiilor
GET {{host}}/api/goods-receipts
